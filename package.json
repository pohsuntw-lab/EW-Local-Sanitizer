{
  "name": "ew-local-sanitizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows-first local pre-upload sanitization for enterprise knowledge forging.",
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch",
    "lint": "node scripts/check-source.mjs && node scripts/check-dependencies.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile && node --test .test-dist/tests/unit/*.test.js",
    "test:fixtures": "npm run test:compile && node --test .test-dist/tests/fixtures/*.test.js",
    "test": "npm run test:unit && npm run test:fixtures",
    "build": "tsc -p tsconfig.build.json",
    "package:win": "node scripts/package-win-placeholder.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "Proprietary",
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
