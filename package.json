{
  "name": "ew-local-sanitizer",
  "version": "0.1.0",
  "productName": "EW Local Sanitizer",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "description": "Windows-first local pre-upload sanitization for enterprise knowledge forging.",
  "author": "Embodied Worker Co., Ltd.",
  "scripts": {
    "dev": "npm run build && electron .",
    "lint": "node scripts/check-source.mjs && node scripts/check-dependencies.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile && node --test .test-dist/tests/unit/*.test.js",
    "test:fixtures": "npm run test:compile && node --test .test-dist/tests/fixtures/*.test.js",
    "test": "npm run test:unit && npm run test:fixtures",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-ui.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "pdfjs-dist": "6.3.289",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract-wasm": "0.11.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild-wasm": "0.28.2",
    "typescript": "5.9.3"
  }
}
